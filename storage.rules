rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // GANTI dengan email owner (huruf kecil). Harus sama dengan firestore.rules.
    function ownerEmails() {
      return ['drawnstorejb@gmail.com'];
    }

    function notBanned() {
      return !firestore.exists(/databases/(default)/documents/banned/$(request.auth.uid));
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && notBanned();
    }

    function isOwner() {
      return signedIn() && request.auth.token.email in ownerEmails();
    }

    // ZIP dan icon tools.
    match /tools/{toolId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner()
        && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isOwner();
    }
  }
}
